{
    "name": "wiriasto/pagi-bagisto",
    "description": "Payment Aggregator & Gateway Indonesia (PAGI) for Bagisto — VA, QRIS, e-Wallet via BDPay Open API",
    "type": "library",
    "version": "1.0",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Wiriasto",
            "homepage": "https://bdpay.co.id"
        }
    ],
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Webkul\\BDPay\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webkul\\BDPay\\Providers\\BDPayServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev"
}
